# Server-side FastAPI origin. Never use NEXT_PUBLIC for secrets or access tokens.
API_ORIGIN=http://127.0.0.1:8109

# Basis URL HTTP untuk klien browser yang menggunakan rewrite Next.js.
NEXT_PUBLIC_API_BASE=/api

# Untuk integrasi WebSocket berikutnya: browser langsung ke FastAPI.
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8109/ws/chat
