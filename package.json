{
  "name": "kodmod-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Asisten belajar AI agentic audio-first untuk siswa tunanetra",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @kodmod/web --",
    "build:web": "npm run build --workspace @kodmod/web",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "start:web": "npm run start --workspace @kodmod/web --",
    "lint:web": "npm run lint --workspace @kodmod/web",
    "typecheck:web": "npm run typecheck --workspace @kodmod/web"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
