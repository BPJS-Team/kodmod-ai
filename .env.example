# Compose deployment settings. Provider secrets belong to apps/ai-engine/.env.
# Local Docker defaults do not require this file.
WEB_PORT=3100
API_PORT=8109
POSTGRES_PORT=5433
REDIS_PORT=6379
KODMOD_TAG=vps

# Required for VPS Compose. Domain only, without https:// or a trailing slash.
APP_DOMAIN=
ACME_EMAIL=
DB_USER=kodmod
DB_NAME=kodmod
# Generate a unique hex secret; use the same password for an existing DB.
DB_PASSWORD=

# Default uses cloud providers and embedding similarity, without local models.
INSTALL_RERANKER=false
RAG_RERANK_ENABLED=false
